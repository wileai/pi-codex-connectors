{
	"name": "@wileai/pi-codex-connector",
	"version": "0.3.0",
	"license": "MIT",
	"description": "Use every connected Codex (ChatGPT) connector from any pi model",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"extension",
		"codex",
		"chatgpt",
		"connectors"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.19"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.99.2",
		"@earendil-works/pi-coding-agent": "0.99.2",
		"@types/node": "26.6.3",
		"typebox": "1.3.27",
		"typescript": "7.0.2"
	},
	"files": [
		"src/",
		"README.md"
	],
	"overrides": {
		"brace-expansion": "^5.0.12"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/wileai/pi-codex-connectors.git"
	},
	"homepage": "https://github.com/wileai/pi-codex-connectors#readme",
	"bugs": {
		"url": "https://github.com/wileai/pi-codex-connectors/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"check": "make check",
		"check:package": "node scripts/check-package.mjs"
	}
}
